{
  "name": "for-you-mom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "serve:offline": "node scripts/serve.mjs dist",
    "qr": "node scripts/generate-qr.mjs",
    "music": "node scripts/generate-music.mjs",
    "test:e2e": "playwright test",
    "check:production": "node scripts/check-production.mjs",
    "format": "prettier --write src tests scripts *.ts *.js package.json *.md"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  }
}
